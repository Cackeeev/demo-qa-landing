# Public application ID from the VK ID developer console. Not a secret.
VK_CLIENT_ID=
# Must match the origin used in your browser and in the VK ID console.
# Use HTTPS on a deployed server. HTTP is only for loopback development.
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
# Register PUBLIC_ORIGIN/auth/vk/callback as the exact redirect URI in VK ID.
# Do not put VK passwords or access tokens in this file.
